{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "--no-env-file",
              "--config=${CLAUDE_PLUGIN_ROOT}/scripts/empty-bunfig.toml",
              "${CLAUDE_PLUGIN_ROOT}/scripts/holyagent.js",
              "hook",
              "session-start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "--no-env-file",
              "--config=${CLAUDE_PLUGIN_ROOT}/scripts/empty-bunfig.toml",
              "${CLAUDE_PLUGIN_ROOT}/scripts/holyagent.js",
              "hook",
              "subagent-start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "--no-env-file",
              "--config=${CLAUDE_PLUGIN_ROOT}/scripts/empty-bunfig.toml",
              "${CLAUDE_PLUGIN_ROOT}/scripts/holyagent.js",
              "hook",
              "vcs-reminder"
            ],
            "timeout": 10,
            "if": "Bash(*git*commit*)"
          },
          {
            "type": "command",
            "command": "bun",
            "args": [
              "--no-env-file",
              "--config=${CLAUDE_PLUGIN_ROOT}/scripts/empty-bunfig.toml",
              "${CLAUDE_PLUGIN_ROOT}/scripts/holyagent.js",
              "hook",
              "vcs-reminder"
            ],
            "timeout": 10,
            "if": "Bash(*git*push*)"
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "--no-env-file",
              "--config=${CLAUDE_PLUGIN_ROOT}/scripts/empty-bunfig.toml",
              "${CLAUDE_PLUGIN_ROOT}/scripts/holyagent.js",
              "hook",
              "workflow"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "--no-env-file",
              "--config=${CLAUDE_PLUGIN_ROOT}/scripts/empty-bunfig.toml",
              "${CLAUDE_PLUGIN_ROOT}/scripts/holyagent.js",
              "hook",
              "agent-launch"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
