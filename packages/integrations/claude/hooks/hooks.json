{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/holyagent",
            "args": [
              "hook",
              "session-start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/holyagent",
            "args": [
              "hook",
              "vcs-redirect"
            ],
            "timeout": 10,
            "if": "Bash(git commit*)",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/holyagent",
            "args": [
              "hook",
              "vcs-redirect"
            ],
            "timeout": 10,
            "if": "Bash(git push*)",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/holyagent",
            "args": [
              "hook",
              "workflow"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
