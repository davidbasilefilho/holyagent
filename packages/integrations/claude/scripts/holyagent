#!/bin/sh
# Generated by packages/integrations/claude/build.ts from packages/integrations/claude/src/wrapper.sh; edit the source and rebuild.
# Runs the bundled holyagent CLI with Bun. Without Bun it prints an error and exits 127 for every
# caller, hooks included, so a missing runtime is never mistaken for a quiet success.
# Every Git Bash fork costs a process on Windows, so the common path forks nothing: no command
# substitution, only parameter expansion and builtins. Only a symlinked wrapper forks, for readlink.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *)
      case $self in
        */*) self=${self%/*}/$link ;;
        *) self=$link ;;
      esac
      ;;
  esac
done
# The directory stays relative to the working directory, which this script never changes.
case $self in
  */*) here=${self%/*} ;;
  *) here=. ;;
esac
# `exec` looks `bun` up on PATH itself, so the test below only checks that it is there.
bun=
if command -v bun >/dev/null 2>&1; then
  bun=bun
elif [ -x "${BUN_INSTALL:-$HOME/.bun}/bin/bun" ]; then
  bun=${BUN_INSTALL:-$HOME/.bun}/bin/bun
fi
if [ -z "$bun" ] || [ ! -f "$here/holyagent.js" ]; then
  printf 'error: BunMissing: Bun or holyagent.js was not found.\nhint: Install Bun from https://bun.sh, then run the command again.\n' >&2
  exit 127
fi
# The working directory is the project, and Bun would load its .env and bunfig.toml there: an .env
# could redirect the state folder and a bunfig preload would run code on every call. Neither may
# change this CLI, so Bun reads no env file and a config file that is empty.
exec "$bun" --no-env-file --config="$here/empty-bunfig.toml" "$here/holyagent.js" "$@"
