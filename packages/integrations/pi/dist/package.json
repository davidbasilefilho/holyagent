{
  "name": "holyagent",
  "version": "0.4.0",
  "description": "HolyAgent for Pi: its skills, its 18 specialists and an extension, built from the shared holyagent runtime.",
  "license": "Apache-2.0",
  "author": "davidbasilefilho",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidbasilefilho/holyagent",
    "directory": "packages/integrations/pi/dist"
  },
  "type": "module",
  "bin": {
    "holyagent": "./scripts/holyagent-public-bin.js",
    "holyagent-cli": "./scripts/holyagent-cli-bin.js"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    "agents",
    "extensions",
    "families",
    "prompts",
    "scripts",
    "guidance"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "prompts": [
      "./prompts"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "dependencies": {
    "@opentui/core": "^0.9.0",
    "@opentui/solid": "^0.9.0",
    "solid-js": "^1.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
